# data — nothing under these is source
data/
*.geojson

# example: your own runs are not committed; the shipped inputs and results are
example/output/*
!example/output/provided/
!example/output/provided/**
example/input/*/example_input.json

# model weights: distributed through GitHub Releases (python download.py → run/src/)
run/src/*.pt

# caches (osmnx / Overpass, ultralytics)
cache/
runs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# virtual environments
.venv/
venv/

# OS / editor
.DS_Store
.vscode/
.ipynb_checkpoints/
